# Default remains runnable without Azure credentials.
REASONER_PROVIDER=rule_based
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_OUTPUT_TOKENS=4096

# Enterprise connector mode: fixtures require no external services.
CONNECTOR_MODE=fixture
ERP_BASE_URL=https://erp.example.com
LOGISTICS_BASE_URL=https://logistics.example.com
CONNECTOR_CONNECT_TIMEOUT_SECONDS=2
CONNECTOR_READ_TIMEOUT_SECONDS=5
CONNECTOR_WRITE_TIMEOUT_SECONDS=5
CONNECTOR_POOL_TIMEOUT_SECONDS=2
CONNECTOR_ATTEMPTS=3
CONNECTOR_BREAKER_THRESHOLD=5
CONNECTOR_BREAKER_OPEN_SECONDS=30

# Durable local action-intent journal.
ACTION_DB_PATH=.runtime/actions.sqlite3
